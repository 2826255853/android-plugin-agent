{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/android-plugin-agent/spec-v1.schema.json",
  "title": "Plugin Project Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "projectId", "version", "status", "title", "goal",
    "storesData", "pages", "collections", "workflows", "permissions",
    "acceptanceCriteria", "unsupportedItems"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "confirmed"] },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["baseVersion", "baseSpecSha256"],
      "properties": {
        "baseVersion": { "type": "integer", "minimum": 1 },
        "baseSpecSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "goal": { "type": "string", "maxLength": 2000 },
    "storesData": { "type": ["boolean", "null"] },
    "pages": {
      "type": "array", "items": { "$ref": "#/$defs/page" },
      "uniqueItems": true
    },
    "collections": {
      "type": "array", "items": { "$ref": "#/$defs/collection" }
    },
    "workflows": {
      "type": "array", "items": { "$ref": "#/$defs/workflow" }
    },
    "permissions": {
      "type": "array", "items": { "$ref": "#/$defs/permission" }
    },
    "acceptanceCriteria": {
      "type": "array", "items": { "$ref": "#/$defs/criterion" }
    },
    "unsupportedItems": {
      "type": "array", "items": { "$ref": "#/$defs/unsupported" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "purpose"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["string", "integer", "number", "boolean"] },
        "required": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "collection": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "trigger", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "trigger": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "permission": {
      "type": "object", "additionalProperties": false,
      "required": ["capability", "justification"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 }
      }
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scenario", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scenario": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 }
      }
    },
    "unsupported": {
      "type": "object", "additionalProperties": false,
      "required": ["request", "reason", "alternative"],
      "properties": {
        "request": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "alternative": { "type": "string", "minLength": 1 }
      }
    }
  }
}

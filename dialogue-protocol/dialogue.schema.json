{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/android-plugin-agent/dialogue-v1.schema.json",
  "title": "Dialogue protocol v1",
  "oneOf": [
    {
      "$ref": "#/$defs/desktopStatus"
    },
    {
      "$ref": "#/$defs/confirmed"
    },
    {
      "$ref": "#/$defs/question"
    },
    {
      "$ref": "#/$defs/draft"
    },
    {
      "$ref": "#/$defs/review"
    },
    {
      "$ref": "#/$defs/desktopError"
    },
    {
      "$ref": "#/$defs/answer"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/revise"
    },
    {
      "$ref": "#/$defs/confirm"
    },
    {
      "$ref": "#/$defs/reject"
    },
    {
      "$ref": "#/$defs/pull"
    },
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/ack"
    },
    {
      "$ref": "#/$defs/accepted"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "slug": {"type":"string","pattern":"^[a-z][a-z0-9-]{2,63}$(?![\\s\\S])"},
    "uuid": {"type":"string","pattern":"^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$(?![\\s\\S])"},
    "utc": {"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])"},
    "sha": {"type":"string","pattern":"^[a-f0-9]{64}$(?![\\s\\S])"},
    "positive": {"type":"integer","minimum":1,"maximum":2147483647},
    "cursor": {"type":"integer","minimum":0,"maximum":2147483647},
    "code": {"enum":["INVALID_REQUEST","UNSUPPORTED_SCHEMA_VERSION","PAYLOAD_TOO_LARGE","AUTH_REQUIRED","DEVICE_REVOKED","SESSION_NOT_FOUND","CURSOR_EXPIRED","INVALID_CURSOR","EVENT_ID_CONFLICT","EVENT_SEQUENCE_CONFLICT","STALE_EVENT","EXPIRED_EVENT","SPEC_MISMATCH","INVALID_STATE","RATE_LIMITED","INTERNAL_ERROR","MODEL_TIMEOUT","MODEL_CANCELLED","MODEL_UNAVAILABLE","MODEL_AUTH_FAILED","MODEL_RATE_LIMITED","MODEL_INVALID_OUTPUT","MODEL_OUTPUT_TOO_LARGE","MODEL_BUDGET_EXHAUSTED","MODEL_ROUND_LIMIT","MODEL_CONFIG_INVALID","MODEL_BUSY","MODEL_USAGE_UNCERTAIN","MODEL_INPUT_TOO_LARGE","MODEL_REQUEST_CONFLICT"]},
    "desktopStatus": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","createdAt","messageId","state"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"desktop.status"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"createdAt":{"$ref":"#/$defs/utc"},"messageId":{"$ref":"#/$defs/uuid"},"state":{"enum":["connected","queued","running","cancelled"]}}},
    "confirmed": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","createdAt","messageId","state","specVersion","specSha256","inReplyTo","savedSpecSha256"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"desktop.status"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"createdAt":{"$ref":"#/$defs/utc"},"messageId":{"$ref":"#/$defs/uuid"},"state":{"const":"confirmed"},"specVersion":{"$ref":"#/$defs/positive"},"specSha256":{"$ref":"#/$defs/sha"},"inReplyTo":{"$ref":"#/$defs/uuid"},"savedSpecSha256":{"$ref":"#/$defs/sha"}}},
    "question": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","createdAt","messageId","specVersion","specSha256","expiresAt","question"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"desktop.question"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"createdAt":{"$ref":"#/$defs/utc"},"messageId":{"$ref":"#/$defs/uuid"},"specVersion":{"$ref":"#/$defs/positive"},"specSha256":{"$ref":"#/$defs/sha"},"expiresAt":{"$ref":"#/$defs/utc"},"question":{"type":"string","minLength":1,"maxLength":2000}}},
    "draft": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","createdAt","messageId","specVersion","specSha256","specJson"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"desktop.draft"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"createdAt":{"$ref":"#/$defs/utc"},"messageId":{"$ref":"#/$defs/uuid"},"specVersion":{"$ref":"#/$defs/positive"},"specSha256":{"$ref":"#/$defs/sha"},"specJson":{"type":"string","minLength":1,"maxLength":49152}}},
    "review": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","createdAt","messageId","specVersion","specSha256","expiresAt","specJson","summary"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"desktop.review"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"createdAt":{"$ref":"#/$defs/utc"},"messageId":{"$ref":"#/$defs/uuid"},"specVersion":{"$ref":"#/$defs/positive"},"specSha256":{"$ref":"#/$defs/sha"},"expiresAt":{"$ref":"#/$defs/utc"},"specJson":{"type":"string","minLength":1,"maxLength":49152},"summary":{"type":"string","minLength":1,"maxLength":2000}}},
    "desktopError": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","createdAt","messageId","code"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"desktop.error"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"createdAt":{"$ref":"#/$defs/utc"},"messageId":{"$ref":"#/$defs/uuid"},"code":{"$ref":"#/$defs/code"}}},
    "answer": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","createdAt","messageId","specVersion","specSha256","inReplyTo","text"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"phone.answer"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"createdAt":{"$ref":"#/$defs/utc"},"messageId":{"$ref":"#/$defs/uuid"},"specVersion":{"$ref":"#/$defs/positive"},"specSha256":{"$ref":"#/$defs/sha"},"inReplyTo":{"$ref":"#/$defs/uuid"},"text":{"type":"string","minLength":1,"maxLength":12000}}},
    "cancel": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","createdAt","messageId","inReplyTo"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"phone.cancel"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"createdAt":{"$ref":"#/$defs/utc"},"messageId":{"$ref":"#/$defs/uuid"},"inReplyTo":{"$ref":"#/$defs/uuid"}}},
    "revise": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","createdAt","messageId","specVersion","specSha256","inReplyTo","text"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"phone.revise"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"createdAt":{"$ref":"#/$defs/utc"},"messageId":{"$ref":"#/$defs/uuid"},"specVersion":{"$ref":"#/$defs/positive"},"specSha256":{"$ref":"#/$defs/sha"},"inReplyTo":{"$ref":"#/$defs/uuid"},"text":{"type":"string","minLength":1,"maxLength":12000}}},
    "confirm": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","createdAt","messageId","specVersion","specSha256","inReplyTo"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"phone.confirm"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"createdAt":{"$ref":"#/$defs/utc"},"messageId":{"$ref":"#/$defs/uuid"},"specVersion":{"$ref":"#/$defs/positive"},"specSha256":{"$ref":"#/$defs/sha"},"inReplyTo":{"$ref":"#/$defs/uuid"}}},
    "reject": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","createdAt","messageId","specVersion","specSha256","inReplyTo"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"phone.reject"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"createdAt":{"$ref":"#/$defs/utc"},"messageId":{"$ref":"#/$defs/uuid"},"specVersion":{"$ref":"#/$defs/positive"},"specSha256":{"$ref":"#/$defs/sha"},"inReplyTo":{"$ref":"#/$defs/uuid"}}},
    "pull": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","after","limit"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"dialogue.pull"},"after":{"$ref":"#/$defs/cursor"},"limit":{"type":"integer","minimum":1,"maximum":20}}},
    "ack": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","through"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"dialogue.ack"},"through":{"$ref":"#/$defs/positive"}}},
    "accepted": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","eventId","sequence","duplicate"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"dialogue.accepted"},"eventId":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/positive"},"duplicate":{"type":"boolean"}}},
    "error": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","code"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"dialogue.error"},"code":{"$ref":"#/$defs/code"}}},
    "page": {"type":"object","additionalProperties":false,"required":["dialogueVersion","deviceId","projectId","sessionId","type","after","next","hasMore","events"],"properties":{"dialogueVersion":{"const":1},"deviceId":{"$ref":"#/$defs/slug"},"projectId":{"$ref":"#/$defs/slug"},"sessionId":{"$ref":"#/$defs/uuid"},"type":{"const":"dialogue.page"},"after":{"$ref":"#/$defs/cursor"},"next":{"$ref":"#/$defs/cursor"},"hasMore":{"type":"boolean"},"events":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"oneOf":[{"$ref":"#/$defs/desktopStatus"},{"$ref":"#/$defs/confirmed"},{"$ref":"#/$defs/question"},{"$ref":"#/$defs/draft"},{"$ref":"#/$defs/review"},{"$ref":"#/$defs/desktopError"}]}}}}
  }
}
